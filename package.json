{
  "name": "codex-multi-account",
  "version": "1.0.0",
  "description": "Multi-account manager for the OpenAI Codex CLI: isolated per-account authentication, shared session history, and cross-account session resume.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "bin": {
    "cma": "bin/cma.js",
    "codex-multi-account": "bin/cma.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loopsmiths-labs/codex-multi-account.git"
  },
  "keywords": [
    "codex",
    "openai",
    "cli",
    "multi-account",
    "account-switcher",
    "chatgpt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "qa": "npm run lint && npm run typecheck && npm run test && npm run build && npm run smoke",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.11"
  }
}
